POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authentication_service
POSTGRES_PASSWORD= 
POSTGRES_DB=authentication_service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info

NODE_ENV=development
PORT=2556
TRUST_PROXY=loopback

OTEL_SERVICE_NAME=authentication
OTEL_SERVICE_VERSION=0.0.0-dev
OTEL_PROMETHEUS_PORT=9464
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_LOGS_EXPORTER=none
# disable all telemetry (no SDK, no metrics port): OTEL_SDK_DISABLED=true

ACCESS_TOKEN_PRIVATE_KEY_PATH=path/to/private/pem/file/private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=path/to/public/pem/file/public.pem

XSRF_TOKEN_KEY=<256bit hex string>
REFRESH_TOKEN_KEY=<256bit hex string>
TOKEN_AUDIENCE=SecureWebIotPlatform

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@domain.tld