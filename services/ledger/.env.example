POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledger_service
POSTGRES_PASSWORD=
POSTGRES_DB=ledger_service

EVENT_BUS_REDIS_HOST=localhost
EVENT_BUS_REDIS_PORT=6379
EVENT_BUS_REDIS_PASSWORD=
EVENT_BUS_REDIS_DB=0

LOG_LEVEL=info
LOKI_HOST=<loki host>

NODE_ENV=<development|production>
PORT=2559

OTEL_SERVICE_NAME=ledger
OTEL_SERVICE_VERSION=0.0.0-dev
OTEL_PROMETHEUS_PORT=9467
# set to disable all telemetry (no SDK, no metrics port): OTEL_SDK_DISABLED=true
# set when a collector/Jaeger is running to ship traces: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

ACCESS_TOKEN_PUBLIC_KEY_PATH = path/to/public/pem/file/public.pem
TOKEN_AUDIENCE = SecureWebIotPlatform
