{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"root": false,
	"extends": ["../biome.json"],
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false,
				"formatWithErrors": true
			},
			"assist": {
				"enabled": false
			},
			"css": {
				"parser": {
					"cssModules": true,
					"tailwindDirectives": true
				},
				"formatter": {
					"enabled": true
				}
			}
		}
	]
}
